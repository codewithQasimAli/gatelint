          ],
          "partialFingerprints": {
            "gatelintFingerprint/v1": "d655253acb9b27c03777480c2d624942"
          },
          "properties": {
            "severity": "high",
            "confidence": "high",
            "scanner": "Bandit",
            "job": "Security scan",
            "step": "Bandit",
            "fix": "remove the flag so the scanner exits non-zero on findings"
          }
        },
        {
          "ruleId": "GL001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "pip-audit failure is swallowed by `|| echo \"pip-audit failed\"`"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "testdata/github/.github/actions/scan/action.yml",
                  "uriBaseId": "%SRCROOT%"
                },
